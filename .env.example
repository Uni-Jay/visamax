# Admin secret used by /admin/reviews and /admin/jobs panel API requests
ADMIN_KEY=replace-with-strong-admin-key

# WhatsApp webhook verification token (Meta dashboard)
WHATSAPP_VERIFY_TOKEN=replace-with-whatsapp-verify-token

# Bearer token MaxHub ERP's JobSyncService sends as `Authorization: Bearer <this>`
# when it pushes a job posting (Draft -> Open) to /api/jobs. Must match the
# JOB_SYNC_VM_API_KEY value set in MaxHub backend/.env exactly.
JOB_SYNC_VM_API_KEY=replace-with-strong-shared-secret

# API server port
PORT=8787
